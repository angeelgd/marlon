{
  "name": "marlon",
  "private": true,
  "version": "0.1.0",
  "description": "Agente personal de organización (PWA + Cloudflare Workers)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "build": "pnpm --filter @marlon/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm build && pnpm --filter @marlon/api deploy",
    "db:migrate:local": "pnpm --filter @marlon/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @marlon/api db:migrate:remote",
    "google:auth": "node --experimental-strip-types scripts/google-auth.ts"
  }
}
