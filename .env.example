# ---------------------------------------------------------------------------
# Marlon: variables y secretos
#
# NADA de esto va al repositorio.
#  - Local:      copia este archivo a apps/api/.dev.vars y rellénalo.
#  - Producción: cada valor con `pnpm --filter @marlon/api exec wrangler secret put NOMBRE`.
# ---------------------------------------------------------------------------

# --- Modelo de IA (formato OpenAI Chat Completions) --------------------------
# "openai-compatible" para un proveedor real, "mock" para desarrollar sin claves.
LLM_PROVIDER=openai-compatible
# Gemini (Google AI Studio) por su endpoint compatible con OpenAI:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Por defecto, el alias que Google mantiene en el Flash más reciente (no caduca).
# Para fijar un modelo concreto, pon su id; mira en AI Studio cuáles tienen cuota gratuita.
LLM_MODEL=gemini-flash-latest
# Solo para proveedores que usen "temperature" (los Gemini 3.x la han dejado obsoleta).
LLM_SEND_TEMPERATURE=0
# Opcional: otro modelo solo para leer fotos.
LLM_VISION_MODEL=
# Clave de la capa gratuita (Google puede usar estos datos para entrenar).
LLM_API_KEY=

# Opcional: clave de una cuenta de pago (los datos no se usan para entrenar).
# Si existe, la foto del horario y los datos económicos van siempre por aquí.
LLM_PAID_API_KEY=
LLM_PAID_BASE_URL=
LLM_PAID_MODEL=

# --- Google Calendar (OAuth, un solo usuario) -------------------------------
# Sin estas tres, Marlon funciona en "modo local" (calendario solo en D1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se obtiene una vez con `pnpm google:auth`.
GOOGLE_REFRESH_TOKEN=

# --- Calendario de la universidad (Lukkari, TUAS) ---------------------------
# URL iCal completa. Su parámetro hash= funciona como una contraseña: solo como secreto.
UNIVERSITY_ICAL_URL=

# --- Rutas (Google Maps Platform, Routes API) --------------------------------
# Opcional. Sin ella, Marlon estima el trayecto con el valor de los ajustes.
# Restringe la clave a la Routes API en la consola de Google Cloud.
GOOGLE_MAPS_API_KEY=

# --- Comida: vídeos de batch cooking ----------------------------------------
# YouTube Data API v3 (búsqueda). Opcional: sin ella puedes pasar enlaces a mano.
YOUTUBE_API_KEY=
# Para que Gemini "vea" vídeos de YouTube (API nativa). Si LLM_BASE_URL es de Gemini,
# se usa LLM_API_KEY y no hace falta.
GEMINI_API_KEY=
LLM_VIDEO_MODEL=

# --- Notificaciones push (Web Push con VAPID) -------------------------------
# Genéralas con `pnpm vapid:generate`. Si las cambias, hay que reactivar las notificaciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# --- Voz del proveedor (opcional) --------------------------------------------
# API compatible con OpenAI /audio/speech. Sin esto se usa la voz del iPhone (gratis).
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=

# --- Acceso ------------------------------------------------------------------
# Mínimo 32 caracteres aleatorios: `openssl rand -base64 48`
SESSION_SECRET=
# Código para registrar la primera passkey: `openssl rand -hex 16`
SETUP_TOKEN=

# Solo en local: entra sin passkey cuando la URL es localhost. NUNCA en producción.
DEV_AUTH_BYPASS=0
