# ---------------------------------------------------------------------------
# Marlon: variables y secretos
#
# NADA de esto va al repositorio.
#  - Local:      copia este archivo a apps/api/.dev.vars y rellénalo.
#  - Producción: cada valor con `pnpm --filter @marlon/api exec wrangler secret put NOMBRE`.
# ---------------------------------------------------------------------------

# --- Modelo de IA (formato OpenAI Chat Completions) --------------------------
# "openai-compatible" para un proveedor real, "mock" para desarrollar sin claves.
LLM_PROVIDER=openai-compatible
# Gemini (Google AI Studio) por su endpoint compatible con OpenAI:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Comprueba en AI Studio qué modelo Flash/Flash-Lite tiene cuota gratuita hoy.
LLM_MODEL=gemini-2.5-flash
# Opcional: otro modelo solo para leer fotos.
LLM_VISION_MODEL=
# Clave de la capa gratuita (Google puede usar estos datos para entrenar).
LLM_API_KEY=

# Opcional: clave de una cuenta de pago (los datos no se usan para entrenar).
# Si existe, la foto del horario y los datos económicos van siempre por aquí.
LLM_PAID_API_KEY=
LLM_PAID_BASE_URL=
LLM_PAID_MODEL=

# --- Google Calendar (OAuth, un solo usuario) -------------------------------
# Sin estas tres, Marlon funciona en "modo local" (calendario solo en D1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se obtiene una vez con `pnpm google:auth`.
GOOGLE_REFRESH_TOKEN=

# --- Acceso ------------------------------------------------------------------
# Mínimo 32 caracteres aleatorios: `openssl rand -base64 48`
SESSION_SECRET=
# Código para registrar la primera passkey: `openssl rand -hex 16`
SETUP_TOKEN=

# Solo en local: entra sin passkey cuando la URL es localhost. NUNCA en producción.
DEV_AUTH_BYPASS=0
